    "url": "https://github.com/MoonPointer-Byte/MoonMusic",
    "summary": "Python + Flet 播放器。容器里用 Flet Web 打开 MoonMusicPC。",
    "scene": "播放器",
    "env": "Docker · Python 3.12 · Flet Web",
    "launch": {
      "kind": "docker",
      "repo": "MoonPointer-Byte/MoonMusic",
      "localPath": "D:/usermoon-src/MoonMusic",
      "fallbackPath": null,
      "cwd": ".",
      "port": 18766,
      "readyPath": "/",
      "image": "docker.1ms.run/library/python:3.12-slim",
      "innerPort": 8080,
      "command": "export PATH=/opt/flet/bin:$PATH PYTHONPATH=/opt/flet/lib/python3.12/site-packages SDL_AUDIODRIVER=dummy && if [ ! -x /opt/flet/bin/flet ]; then pip install --no-cache-dir --prefix /opt/flet -r MoonMusicPC/requirements.txt flet==0.28.3 flet-desktop==0.28.3; fi && cd MoonMusicPC && flet run --web --host 0.0.0.0 --port 8080 main.py",
      "modulesVolume": null,
      "caches": [
        {
          "volume": "usermoon-moonmusic-py",
          "at": "/opt/flet"
        }
      ]
    }
  },
