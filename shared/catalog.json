  {
    "id": "evadance",
    "name": "EvaDance",
    "year": "2026",
    "lang": "React",
    "weight": "重",
    "tags": [
      "私有",
      "BI",
      "飞书"
    ],
    "url": "https://github.com/MoonPointer-Byte/EvaDance",
    "summary": "隐藏项目。优化师分配与 BI / 飞书集成，FastAPI + React。这里按官方方式启动前端（5173），后端是 Python 8000，需要 .env。",
    "scene": "分配台",
    "env": "Docker · Node 20",
    "launch": {
      "kind": "docker",
      "repo": "MoonPointer-Byte/EvaDance",
      "localPath": "D:/usermoon-src/EvaDance",
      "fallbackPath": null,
      "cwd": ".",
      "port": 18767,
      "readyPath": "/",
      "image": "docker.1ms.run/library/python:3.12-slim",
      "innerPort": 8080,
      "command": "export PATH=/opt/py/bin:/opt/node/bin:$PATH PYTHONPATH=/opt/py/lib/python3.12/site-packages EVA_ENV=development EVA_LOCAL_DEV_AUTH=1 EVA_LOCAL_DEV_USERNAME=localdev EVA_LOCAL_DEV_PASSWORD=local-dev-pass EVA_COOKIE_SECURE=0 MYSQL_HOST=host.docker.internal MYSQL_PORT=3306 MYSQL_USER=root MYSQL_PASSWORD=\"${MYSQL_PASSWORD:-usermoon}\" MYSQL_DATABASE=tool_platform && if ! command -v node >/dev/null 2>&1; then apt-get update && apt-get install -y ca-certificates curl xz-utils && mkdir -p /opt/node && curl -fsSL https://cdn.npmmirror.com/binaries/node/v20.19.5/node-v20.19.5-linux-x64.tar.xz -o /tmp/node.tar.xz && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1; fi && if ! python -c 'import fastapi'; then pip install --no-cache-dir --prefix /opt/py -r requirements.txt; fi && python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 >/tmp/api.log 2>&1 & i=0 && ok=0 && while [ $i -lt 180 ]; do python -c 'import sys,urllib.request; urllib.request.urlopen(sys.argv[1], timeout=2)' http://127.0.0.1:8000/api/health/live && ok=1 && break; i=$((i+1)); sleep 2; done && test $ok = 1 || { cat /tmp/api.log; exit 1; } && cd frontend && if [ ! -x node_modules/.bin/vite ]; then npm install; fi && npx vite --host 0.0.0.0 --port 8080",
      "modulesVolume": "usermoon-evadance-nm",
      "modulesAt": "/app/frontend/node_modules",
      "caches": [
        {
          "volume": "usermoon-evadance-node",
          "at": "/opt/node"
        },
        {
          "volume": "usermoon-evadance-py",
          "at": "/opt/py"
        }
      ]
    }
  },
