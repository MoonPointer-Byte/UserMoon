# MoonPointer Agent（OpenAI 兼容；不填也能用站内搜索兜底）
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_MODEL=deepseek-chat
AGENT_REACT_MAX_STEPS=10

# MySQL（元数据：访问、留言、文章索引、Agent 索引、设置）
# 与 docker-compose 默认一致；生产请换成强密码
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=usermoon
MYSQL_DATABASE=usermoon

# MongoDB（文章正文 html/body_text、Agent payload）
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=usermoon

# 主人密钥：绑定 CSDN/GitHub、数据台读写。访客无此密钥不能改站。
# 至少 8 位；生产务必换成自己的随机串
USERMOON_OWNER_TOKEN=change-me-owner-token

# 生产 docker compose（服务器上）
APP_PORT=80
# MYSQL_PASSWORD=换成强密码
# USERMOON_OWNER_TOKEN=换成强密钥

